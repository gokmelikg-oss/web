# Şimşek Solar — ortam değişkenleri örneği
# Yayına alırken bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# (.env.local git'e gönderilmez.)

# --- Form e-posta iletimi (Resend) ---
# https://resend.com üzerinden ücretsiz hesap açıp simseksolar.com.tr alan adını doğrulayın.
RESEND_API_KEY=
# Gönderen adresi (doğrulanmış alan adında olmalı). Boş bırakılırsa varsayılan kullanılır.
CONTACT_FROM="Şimşek Solar <bildirim@simseksolar.com.tr>"

# --- Ölçüm / Analitik ---
# Google Analytics 4 ölçüm kimliği (Analytics > Yönetici > Veri akışı)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel kimliği
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console doğrulama kodu (meta etiketi yöntemi; sadece kod kısmı)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Yönetim paneli (/admin) ---
# Panele KULLANICI ADI + ŞİFRE ile girilir. Henüz hiç kullanıcı yoksa, aşağıdaki
# şifreyle "admin" adlı yönetici hesabı ilk girişte otomatik oluşturulur.
# Sonraki hesaplar panelin "Kullanıcılar" bölümünden açılır.
ADMIN_PASSWORD=

# Oturum çerezinin imza anahtarı. Tanımlanması ÖNERİLİR: boş bırakılırsa imza
# ADMIN_PASSWORD'dan türetilir ve şifre değişince herkesin oturumu düşer.
# Uzun ve rastgele bir değer verin (ör. `openssl rand -base64 32` çıktısı).
ADMIN_SECRET=

# --- Admin içerik depolama (Vercel KV / Upstash Redis) ---
# Vercel > Storage > KV store oluşturup projeye bağlayınca bu iki değişken
# OTOMATİK eklenir. Tanımlıysa admin içeriği KV'de kalıcı saklanır; yoksa
# yerel dosyaya (content/site.json) yazılır. Yerel geliştirmede boş bırakılabilir.
KV_REST_API_URL=
KV_REST_API_TOKEN=
